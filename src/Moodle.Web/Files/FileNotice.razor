@if (Loading)
{
    <p role="status" class="crs-notice">@LoadingText</p>
}
@if (Error is not null)
{
    <section class="crs-notice crs-error" role="alert" data-error-code="@Error.Code">
        <h2>@Heading</h2>
        <p>@Error.Message</p>
        <button type="button" disabled="@Busy" @onclick="OnRetry">Yeniden dene</button>
    </section>
}
@if (!string.IsNullOrEmpty(Success))
{
    <p role="status" class="crs-notice crs-success">@Success</p>
}

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Dosyalar yükleniyor…";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public FileApiException? Error { get; set; }
    [Parameter] public string? Success { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    private string Heading => Error?.Code switch
    {
        "auth_not_ready" => "Dosya işlemleri henüz kullanılamıyor",
        "maintenance_running" => "Temizlik zaten çalışıyor",
        "not_authenticated" => "Oturum açmanız gerekiyor",
        _ => "İşlem tamamlanamadı",
    };
}
