@using Microsoft.AspNetCore.Components.Authorization

<nav class="app-nav" aria-label="Ana menü">
    <NavLink href="/" Match="NavLinkMatch.All">Ana sayfa</NavLink>
    <NavLink href="courses">Dersler</NavLink>
    <NavLink href="grades">Notlar</NavLink>
    @* Modüller sayfalarını ekledikçe buraya bağlantı koyar:
       CRS: Dersler · ASG: Ödevler · GRD: Notlarım *@
    <NavLink href="courses">Ödevler (ders seç)</NavLink>
    <NavLink href="admin/files">Dosya ayarları</NavLink>
    <AuthorizeView>
        <Authorized>
            <span class="app-user">@context.User.Identity?.Name</span>
            <a href="/logout">Çıkış yap</a>
        </Authorized>
        <NotAuthorized>
            <NavLink href="/login">Giriş yap</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>
