@page "/change-password"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Moodle.Web.Auth
@inject AuthApiClient Api
@inject NavigationManager Nav

@* AUTH-FR-09 / AUTH-BR-06 (YZ destekli, Claude Code): mevcut POST /api/v1/auth/change-password ucunu kullanır. *@
<PageTitle>Parola değiştir · Moodle</PageTitle>
<h1>Parola değiştir</h1>

@if (Required)
{
    <p role="status">Devam etmek için parolanızı değiştirmeniz gerekiyor.</p>
}
@if (error is not null)
{
    <p role="alert">@error</p>
}
<noscript><p>Parola değiştirmek için JavaScript'i etkinleştirin.</p></noscript>

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <p>
        <label for="current-password">Mevcut parola</label><br />
        <InputText id="current-password" type="password" @bind-Value="_model.CurrentPassword" disabled="@_busy" autocomplete="current-password" />
    </p>
    <p>
        <label for="new-password">Yeni parola</label><br />
        <InputText id="new-password" type="password" @bind-Value="_model.NewPassword" disabled="@_busy" autocomplete="new-password" />
    </p>
    <p>
        <label for="confirm-password">Yeni parola (tekrar)</label><br />
        <InputText id="confirm-password" type="password" @bind-Value="_model.ConfirmPassword" disabled="@_busy" autocomplete="new-password" />
    </p>
    <button type="submit" disabled="@_busy">@(_busy ? "Kaydediliyor..." : "Parolayı değiştir")</button>
</EditForm>

@code {
    public const string RequiredPath = "/change-password?required=true";

    [SupplyParameterFromQuery(Name = "required")]
    public bool Required { get; set; }

    private readonly ChangePasswordModel _model = new();
    private string? error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        error = null;
        try
        {
            await Api.ChangePasswordAsync(_model.CurrentPassword, _model.NewPassword);
            // Zorunluluk sunucuda kaldırıldı; normal akışa yeni bir istekle dönülür.
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (AuthApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ChangePasswordModel
    {
        [Required(ErrorMessage = "Mevcut parola zorunludur.")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "Yeni parola zorunludur.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Yeni parola tekrarı zorunludur.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Yeni parolalar eşleşmiyor.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
