@page "/assignments/{Id:int}/submissions"
@using Moodle.Web.Assignments
@inject AsgClient Api
<h1>Teslim listesi</h1>
<p><a href="@($"/assignments/{Id}")">Ödeve dön</a></p>
<form method="get">
    <label>Durum <select name="status"><option value="" selected="@(string.IsNullOrEmpty(Status))">Tümü</option><option value="draft" selected="@(Status == "draft")">Taslak</option><option value="submitted" selected="@(Status == "submitted")">Gönderildi</option><option value="notSubmitted" selected="@(Status == "notSubmitted")">Teslim edilmedi</option></select></label>
    <button type="submit">Filtrele</button>
</form>
@if (error is not null) { <p role="alert">@error</p> }
else if (data is null) { <p>Yükleniyor…</p> }
else if (data.Items.Length == 0) { <p>Bu görünümde öğrenci bulunamadı.</p> }
else
{
    <table>
        <thead><tr><th>Öğrenci kimliği</th><th>Durum</th><th>Gönderme (UTC)</th><th>Gecikme</th><th>Teslim</th></tr></thead>
        <tbody>@foreach (var row in data.Items)
        {
            <tr><td>@row.LearnerId</td><td>@Labels.Status(row.Status)</td><td>@row.SubmittedAt?.ToString("u")</td><td>@(row.IsLate ? "Geç" : "—")</td>
            <td>@if (row.SubmissionId is int sid) { <a href="@($"/assignments/{Id}/submissions/{sid}")">Aç</a> }</td></tr>
        }</tbody>
    </table>
    @if (data.NextCursor is int next) { <a href="@($"/assignments/{Id}/submissions?cursor={next}&status={Uri.EscapeDataString(Status ?? "")}")">Sonraki sayfa</a> }
}
@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public int? Cursor { get; set; }
    private SubmissionPage? data;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        try { data = await Api.SendAsync<SubmissionPage>(HttpMethod.Get,
            $"/api/v1/assignments/{Id}/submissions?limit=50{(Cursor is null ? "" : $"&cursor={Cursor}")}{(string.IsNullOrEmpty(Status) ? "" : $"&status={Uri.EscapeDataString(Status)}")}"); }
        catch (Exception ex) when (ex is AsgClientException or HttpRequestException)
        { error = ex is AsgClientException ? ex.Message : "Sunucuya ulaşılamadı."; }
    }
}
